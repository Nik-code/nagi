{
  "manifest_version": 3,
  "name": "Nagi",
  "short_name": "Nagi",
  "description": "A calm layer for Chrome: new tab, spaces panel and a command bar. Reads no web pages.",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Nagi command bar",
    "default_popup": "command/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "clipboardWrite",
    "favicon",
    "history",
    "offscreen",
    "search",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs",
    "topSites"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Open the command bar"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Open or close the spaces panel"
    },
    "copy-url": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Copy the current tab's link"
    },
    "next-space": {
      "description": "Focus the next space"
    },
    "previous-space": {
      "description": "Focus the previous space"
    }
  }
}
